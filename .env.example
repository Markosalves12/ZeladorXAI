# Copie para .env e preencha localmente; este arquivo não contém credenciais.
# OBRIGATÓRIO: mesma SECRET_KEY, banco, host e cookie usados no ZeladorX/Chat/Ops.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=zeladorx
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Alternativa: DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/zeladorx
SESSION_ENGINE=django.contrib.sessions.backends.db
SESSION_COOKIE_NAME=sessionid
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
LMSTUDIO_URL=http://127.0.0.1:1234/v1
# IDs exatos exibidos em GET /v1/models; carregue modelo com tool calling.
LMSTUDIO_CHAT_MODEL=
LMSTUDIO_EMBED_MODEL=
LMSTUDIO_API_KEY=
LMSTUDIO_TIMEOUT=180
# ID do gerente que autoriza o processo MCP LOCAL. Nunca fornecido pela ferramenta.
MCP_USER_ID_RANDOM=
